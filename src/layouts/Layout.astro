---
import '@fontsource/shippori-mincho/latin-400.css';
import '@fontsource/shippori-mincho/latin-500.css';
import '@fontsource/zen-kaku-gothic-new/latin-300.css';
import '@fontsource/zen-kaku-gothic-new/latin-400.css';
import '@fontsource/zen-kaku-gothic-new/latin-500.css';
import '../styles/global.css';
import { site, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  // Página de error: sin canonical, sin alternativas y fuera del índice
  notFound?: boolean;
}

const { lang, notFound = false } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const title = notFound ? t(lang, '404.title') : t(lang, 'meta.title');
const description = t(lang, 'meta.description');
const url = site.url + site.path[lang];
const image = `${site.url}/img/og-${lang}.png`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stefano Delmonte',
  jobTitle: t(lang, 'hero.title'),
  url: site.url,
  image: `${site.url}/apple-touch-icon.png`,
  email: `mailto:${site.email}`,
  sameAs: [site.linkedin, site.github],
  alumniOf: { '@type': 'EducationalOrganization', name: 'La Salle Tarragona' },
  knowsLanguage: ['es', 'ca', 'en', 'it'],
};
---

<!DOCTYPE html>
<html lang={lang} data-lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F4F1EA" />
  <meta name="color-scheme" content="light dark" />
  {notFound ? (
    <meta name="robots" content="noindex" />
  ) : (
    <>
      <link rel="canonical" href={url} />
      <link rel="alternate" hreflang="es" href={site.url + site.path.es} />
      <link rel="alternate" hreflang="en" href={site.url + site.path.en} />
      <link rel="alternate" hreflang="x-default" href={site.url + site.path.es} />
    </>
  )}

  <!-- Tema antes de pintar: la elección guardada manda; sin ella, el tema del sistema vía CSS -->
  <script is:inline>
    (function () {
      var theme = null;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      else theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (theme === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#14120F');
    })();
  </script>

  <!-- Elige idioma antes de pintar, solo al entrar por la raíz: un enlace a /en/ se respeta siempre -->
  <script is:inline define:vars={{ paths: site.path }}>
    (function () {
      document.documentElement.classList.add('js');
      if (location.pathname !== paths.es) return;
      if (/bot|crawl|spider|slurp|preview|lighthouse/i.test(navigator.userAgent)) return;
      var stored = null;
      try { stored = localStorage.getItem('lang'); } catch (e) {}
      var nav = (navigator.language || '').toLowerCase();
      var pref = stored || (/^(es|ca|gl|eu)/.test(nav) ? 'es' : 'en');
      if (pref === 'en') location.replace(paths.en + location.hash);
    })();
  </script>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Stefano Delmonte" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content={site.locale[lang]} />
  <meta property="og:locale:alternate" content={site.locale[other]} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={t(lang, 'meta.imageAlt')} />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  {!notFound && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
</head>
<body>
  <slot />
</body>
</html>
