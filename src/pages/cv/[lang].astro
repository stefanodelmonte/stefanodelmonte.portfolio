---
// CV descargable: misma información, textos y estilo que la web, maquetado para A4.
// No se enlaza ni se indexa; `npm run cv` lo imprime a PDF en public/cv/
import '@fontsource/shippori-mincho/latin-400.css';
import '@fontsource/shippori-mincho/latin-500.css';
import '@fontsource/zen-kaku-gothic-new/latin-300.css';
import '@fontsource/zen-kaku-gothic-new/latin-400.css';
import '@fontsource/zen-kaku-gothic-new/latin-500.css';
import '../../styles/global.css';
import { site, t as translate, type Lang, type Key } from '../../i18n';
import { projects, pk, skills, languages, experience } from '../../data/profile';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = (key: Key) => translate(lang, key);
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="robots" content="noindex" />
  <title>{t('cv.title')}</title>
</head>
<body class="cv">
  <header class="cv-head">
    <div class="cv-sumi" aria-hidden="true"><canvas id="cvSumi"></canvas></div>
    <h1>Stefano <span class="nowrap">Delmonte<span class="seal-anchor" aria-hidden="true"><span class="seal is-stamped"><span>S</span><span>D</span></span></span></span></h1>
    <p class="cv-role">{t('hero.title')}</p>
    <p class="cv-contact">
      <span>{t('cv.location')}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.url}>{bare(site.url)}</a>
      <a href={site.github}>{bare(site.github)}</a>
      <a href={site.linkedin}>{bare(site.linkedin)}</a>
    </p>
  </header>

  <section class="cv-section">
    <h2 class="cv-heading">{t('projects.heading')}</h2>
    <div class="cv-projects">
      {projects.filter((p) => p.cv !== false).map((p) => (
        <article>
          <h3><span class="cv-project">{t(pk(p.id, 'title'))}</span><span class="cv-status">{t(pk(p.id, 'status'))}</span></h3>
          <p>{t(pk(p.id, 'solution'))}</p>
          <p class="cv-stack">{p.stack.join(' · ')}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="cv-section">
    <h2 class="cv-heading">{t('about.heading')}</h2>
    <div class="cv-about">
      <p class="lead">{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
    </div>
    <dl class="cv-facts">
      {skills.map((group) => (
        <div>
          <dt>{t(group.key)}</dt>
          <dd><ul>{group.items.map((item) => <li>{item}</li>)}</ul></dd>
        </div>
      ))}
      <div>
        <dt>{t('education.languages')}</dt>
        <dd>
          <ul class="cv-langs">
            {languages.map((l) => (
              <li><span>{t(l.key)}</span><span class="muted">{l.level === 'B2' ? 'B2' : t(l.level)}</span></li>
            ))}
          </ul>
        </dd>
      </div>
      <div>
        <dt>{t('about.education')}</dt>
        <dd>
          <span>{t('education.degree')}</span>
          <span class="muted">La Salle Tarragona · {t('education.dates')}</span>
        </dd>
      </div>
    </dl>
  </section>

  <section class="cv-section">
    <h2 class="cv-heading">{t('cv.experience')}</h2>
    <div class="cv-jobs">
      {experience.map((job) => (
        <article>
          <h3>{job.company}</h3>
          <ul>{job[lang].map((line) => <li>{line}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <script>
    // Montañas de la cabecera: el mismo shader que el fondo de la web, pintado una vez y quieto
    import { VERT, FRAG } from '../../scripts/sumi';

    const canvas = document.getElementById('cvSumi') as HTMLCanvasElement | null;
    const gl = canvas?.getContext('webgl', { alpha: true, premultipliedAlpha: true, preserveDrawingBuffer: true, antialias: false });

    if (canvas && gl) {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      // Resolución alta para que se vea nítido impreso
      canvas.width = w * 4;
      canvas.height = h * 4;

      const prog = gl.createProgram()!;
      for (const [type, src] of [[gl.VERTEX_SHADER, VERT], [gl.FRAGMENT_SHADER, FRAG]] as const) {
        const s = gl.createShader(type)!;
        gl.shaderSource(s, src);
        gl.compileShader(s);
        gl.attachShader(prog, s);
      }
      gl.bindAttribLocation(prog, 0, 'a_pos');
      gl.linkProgram(prog);
      gl.useProgram(prog);
      const u = (name: string) => gl.getUniformLocation(prog, name);

      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

      const hex = getComputedStyle(document.documentElement).getPropertyValue('--mountain').trim();
      const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(u('u_res'), canvas.width, canvas.height);
      // Proporción con la que el shader compone la cordillera completa: así ocupa todo el ancho
      gl.uniform1f(u('u_aspect'), 1.6);
      gl.uniform1f(u('u_scale'), 1);
      // Sin hundir la parte izquierda: en la hoja no hay texto que esquivar dentro del lienzo
      gl.uniform1f(u('u_spread'), 0.5);
      gl.uniform3f(u('u_ink'), r, g, b);
      gl.uniform1f(u('u_paint'), 1); // ya pintadas
      gl.uniform1f(u('u_fade'), 1);
      gl.uniform1f(u('u_veil'), 0);
      gl.uniform1f(u('u_scroll'), 0);
      gl.uniform1f(u('u_mx'), 0);
      gl.uniform1f(u('u_time'), 0);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    } else if (canvas) {
      canvas.parentElement!.hidden = true;
    }
  </script>
</body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }

  html { font-size: 9.2pt; scroll-padding-top: 0; }
  body.cv {
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 14mm 17mm 8mm;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    line-height: 1.5;
    font-weight: 400;
  }
  .cv a { text-decoration: none; }

  .cv-head { position: relative; margin-bottom: 5mm; }
  .cv-sumi {
    position: absolute;
    /* Ocupa el hueco a la derecha del nombre, desde el borde superior hasta el final de la cabecera */
    top: -14mm;
    bottom: 0;
    left: 98mm;
    right: -17mm;
    pointer-events: none;
    /* La base se funde con el papel justo en la línea de la cabecera */
    -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, #000 82%, transparent);
  }
  /* Un canvas no se estira con left/right/bottom: llena el contenedor, que sí lo hace */
  .cv-sumi canvas { display: block; width: 100%; height: 100%; }
  .cv-head h1 {
    position: relative;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 30pt;
    line-height: 1.05;
    letter-spacing: -.01em;
  }
  .cv-head .seal { width: 1.9rem; padding: .3rem 0; font-size: .8rem; }
  .cv-role {
    margin-top: .3rem;
    font-family: var(--font-serif);
    font-size: 13pt;
  }
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    margin-top: .6rem;
    max-width: 120mm;
    font-size: .88rem;
    color: var(--gray);
  }
  .cv-contact a { color: var(--ink); }

  .cv-section { margin-top: 4.5mm; }
  .cv-heading {
    margin-bottom: 2.5mm;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 15pt;
    line-height: 1.2;
  }

  .cv-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3mm 8mm;
  }
  .cv-projects h3 { font-weight: 400; }
  .cv-project {
    font-family: var(--font-serif);
    font-size: 11pt;
  }
  .cv-status {
    display: block;
    font-size: .78rem;
    letter-spacing: .14em;
    color: var(--gray);
  }
  .cv-stack { font-size: .88rem; color: var(--gray); }

  .cv-about { display: grid; gap: .5rem; max-width: 165mm; }
  .cv-about .lead { font-family: var(--font-serif); font-size: 10.5pt; }

  .cv-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 1.2fr);
    gap: 4mm 6mm;
    margin-top: 4mm;
  }
  .cv-facts > div { display: grid; align-content: start; gap: .35rem; }
  .cv-facts dt,
  .cv-jobs h3 + ul li::marker { color: var(--gray); }
  .cv-facts dt {
    font-size: .78rem;
    letter-spacing: .16em;
    color: var(--gray);
  }
  .cv-facts dd { display: grid; gap: .1rem; }
  .cv-facts dd ul { display: grid; gap: .05rem; }
  .cv-langs li { display: flex; justify-content: space-between; gap: 1rem; }

  .cv-jobs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3mm 8mm;
  }
  .cv-jobs h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 11pt;
  }
  .cv-jobs ul { color: var(--gray); }

  /* En pantalla: hoja centrada sobre el papel */
  @media screen {
    html { background: var(--line); }
    body.cv { margin-block: 2rem; box-shadow: 0 .5rem 2rem rgb(0 0 0 / .12); }
  }
</style>
