---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stefano Delmonte | Portfolio">

  <!-- NAV -->
  <nav>
    <div class="container">
      <a href="#" class="nav-logo">SD</a>
      <button class="menu-toggle" aria-label="Menu">&#9776;</button>
      <ul class="nav-links">
        <li><a href="#about" data-i18n="nav.about">Sobre mi</a></li>
        <li><a href="#skills" data-i18n="nav.skills">Habilidades</a></li>
        <li><a href="#projects" data-i18n="nav.projects">Proyectos</a></li>
        <li><a href="#contact" data-i18n="nav.contact">Contacto</a></li>
        <li><button class="lang-btn" id="langToggle">EN</button></li>
      </ul>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" id="about">
    <div class="container">
      <div class="hero-content">
        <div class="hero-photo animate-in">
          <div class="hero-photo-placeholder">foto</div>
        </div>
        <div class="hero-text">
          <h1 class="animate-in delay-1">
            <span data-i18n="hero.greeting">Hola, soy</span><br />
            Stefano Delmonte
          </h1>
          <p class="role animate-in delay-2" data-i18n="hero.role">
            Estudiante de Desarrollo de Aplicaciones Multiplataforma
          </p>
          <p class="description animate-in delay-3" data-i18n="hero.description">
            Me gusta la tecnologia y resolver problemas. Actualmente estoy formandome como desarrollador, aprendiendo cada dia algo nuevo y buscando oportunidades para crecer profesionalmente en el mundo del software.
          </p>
          <div class="hero-actions animate-in delay-4">
            <a href="/cv/stefano-delmonte-cv.pdf" download class="btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span data-i18n="hero.downloadCV">Descargar CV</span>
            </a>
            <div class="social-links">
              <a href="https://www.linkedin.com/in/delmontestefano/" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://github.com/stefanodelmonte" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </a>
              <a href="mailto:sdelmonteperez@gmail.com" class="social-link" aria-label="Email">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills">
    <div class="container">
      <div class="section-title">
        <span data-i18n="skills.title">Habilidades</span>
      </div>
      <p class="skills-label"><span data-i18n="skills.learning">Aprendiendo</span></p>
      <div class="skills-grid">
        <span class="skill-tag">Java</span>
        <span class="skill-tag">Spring Boot</span>
        <span class="skill-tag">PostgreSQL</span>
        <span class="skill-tag">HTML</span>
        <span class="skill-tag">CSS</span>
        <span class="skill-tag">JavaScript</span>
        <span class="skill-tag">Git</span>
        <span class="skill-tag">Linux</span>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects">
    <div class="container">
      <div class="section-title">
        <span data-i18n="projects.title">Proyectos</span>
      </div>
      <div class="projects-placeholder">
        <h3 data-i18n="projects.comingSoon">Proximamente</h3>
        <p data-i18n="projects.comingSoonDesc">Estoy trabajando en varios proyectos que publicare aqui cuando esten listos.</p>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <div class="container">
      <div class="section-title">
        <span data-i18n="contact.title">Contacto</span>
      </div>
      <div class="contact-content">
        <p data-i18n="contact.description">Si quieres ponerte en contacto conmigo, puedes escribirme un correo o encontrarme en LinkedIn.</p>
        <div class="contact-actions">
          <a href="mailto:sdelmonteperez@gmail.com" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span data-i18n="contact.email">Enviar correo</span>
          </a>
          <a href="https://www.linkedin.com/in/delmontestefano/" target="_blank" rel="noopener" class="social-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container">
      <p>&copy; 2026 Stefano Delmonte. <span data-i18n="footer.rights">Todos los derechos reservados.</span></p>
    </div>
  </footer>

  <script>
    // ---- i18n ----
    const translations = {
      es: {
        'nav.about': 'Sobre mi',
        'nav.skills': 'Habilidades',
        'nav.projects': 'Proyectos',
        'nav.contact': 'Contacto',
        'hero.greeting': 'Hola, soy',
        'hero.role': 'Estudiante de Desarrollo de Aplicaciones Multiplataforma',
        'hero.description': 'Me gusta la tecnologia y resolver problemas. Actualmente estoy formandome como desarrollador, aprendiendo cada dia algo nuevo y buscando oportunidades para crecer profesionalmente en el mundo del software.',
        'hero.downloadCV': 'Descargar CV',
        'skills.title': 'Habilidades',
        'skills.learning': 'Aprendiendo',
        'projects.title': 'Proyectos',
        'projects.comingSoon': 'Proximamente',
        'projects.comingSoonDesc': 'Estoy trabajando en varios proyectos que publicare aqui cuando esten listos.',
        'contact.title': 'Contacto',
        'contact.description': 'Si quieres ponerte en contacto conmigo, puedes escribirme un correo o encontrarme en LinkedIn.',
        'contact.email': 'Enviar correo',
        'footer.rights': 'Todos los derechos reservados.',
      },
      en: {
        'nav.about': 'About',
        'nav.skills': 'Skills',
        'nav.projects': 'Projects',
        'nav.contact': 'Contact',
        'hero.greeting': "Hi, I'm",
        'hero.role': 'Multiplatform Application Development Student',
        'hero.description': "I enjoy technology and solving problems. I'm currently training as a developer, learning something new every day and looking for opportunities to grow professionally in the software world.",
        'hero.downloadCV': 'Download CV',
        'skills.title': 'Skills',
        'skills.learning': 'Learning',
        'projects.title': 'Projects',
        'projects.comingSoon': 'Coming soon',
        'projects.comingSoonDesc': "I'm working on several projects that I'll publish here once they're ready.",
        'contact.title': 'Contact',
        'contact.description': "If you'd like to get in touch, feel free to send me an email or find me on LinkedIn.",
        'contact.email': 'Send email',
        'footer.rights': 'All rights reserved.',
      }
    };

    let currentLang = 'es';

    function setLanguage(lang) {
      currentLang = lang;
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang][key]) {
          el.textContent = translations[lang][key];
        }
      });
      const btn = document.getElementById('langToggle');
      btn.textContent = lang === 'es' ? 'EN' : 'ES';
    }

    document.getElementById('langToggle').addEventListener('click', () => {
      setLanguage(currentLang === 'es' ? 'en' : 'es');
    });

    // ---- Mobile menu ----
    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelector('.nav-links');

    menuToggle.addEventListener('click', () => {
      navLinks.classList.toggle('active');
    });

    // Close menu on link click
    if (navLinks) {
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('active');
        });
      });
    }
  </script>

</Layout>
