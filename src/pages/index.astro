        'contact.copy': 'Copiar correo',
        'contact.copied': '¡Copiado!',
        'footer.rights': 'Todos los derechos reservados.',
      },
      en: {
        'nav.about': 'About',
        'nav.skills': 'Skills',
        'nav.education': 'Education',
        'nav.projects': 'Projects',
        'nav.contact': 'Contact',
        'hero.status': 'Available for internship · Hybrid / Remote',
        'hero.greeting': "Hi, I'm",
        'hero.role': 'Multiplatform Application Development Student',
        'hero.description': "I enjoy technology and solving problems. I'm currently training as a developer, learning something new every day and looking for opportunities to grow professionally in the software world.",
        'hero.downloadCV': 'Download CV',
        'skills.title': 'Skills',
        'skills.backend': 'Backend',
        'skills.frontend': 'Frontend & Mobile',
        'skills.tools': 'Data & Environment',
        'education.title': 'Education & Languages',
        'education.dam.title': 'Higher Diploma in Multiplatform App Development (DAM)',
        'education.dam.year': '2nd year',
        'education.dam.desc': 'Backend development with Java & Spring Boot, relational persistence (SQL/JPA), cross-platform interfaces and mobile development with Kotlin.',
        'education.languages': 'Languages',
        'lang.es': 'Spanish',
        'lang.ca': 'Catalan',
        'lang.it': 'Italian',
        'lang.en': 'English',
        'lang.native': 'Native',
