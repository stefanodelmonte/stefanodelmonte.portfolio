    let currentLang = 'es';

    function renderCopyButton() {
      const copyBtnEl = document.getElementById('copyEmailBtn');
      if (!copyBtnEl) return;
      const svg = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const langData = translations[currentLang as keyof typeof translations];
      copyBtnEl.innerHTML = svg + `<span class="copy-label">${langData['contact.copy']}</span>`;
      copyBtnEl.setAttribute('aria-label', langData['contact.copy']);
    }

    function setLanguage(lang: string) {
      currentLang = lang;
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        const langData = translations[lang as keyof typeof translations];
        if (key && langData[key as keyof typeof langData]) {
          el.textContent = langData[key as keyof typeof langData];
        }
      });
      const btn = document.getElementById('langToggle');
      if (btn) {
        btn.innerHTML = lang === 'es' ? '<span class="flag" aria-hidden="true">🇪🇸</span> <span class="lang-label">ES</span>' : '<span class="flag" aria-hidden="true">🇬🇧</span> <span class="lang-label">EN</span>';
      }
      const cvLink = document.getElementById('cvDownload') as HTMLAnchorElement | null;
      if (cvLink) {
        cvLink.href = lang === 'es' ? '/cv/stefano-delmonte-cv-es.pdf' : '/cv/stefano-delmonte-cv-en.pdf';
      }
      renderCopyButton();
    }

    setLanguage(currentLang);

    document.getElementById('langToggle')?.addEventListener('click', () => {
      setLanguage(currentLang === 'es' ? 'en' : 'es');
    });

    // ---- BOTÓN COPIAR EMAIL ----
    const copyBtn = document.getElementById('copyEmailBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || 'contactstefanodelmonte@gmail.com';
        try {
          await navigator.clipboard.writeText(email);
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = `<span class="copy-label">${translations[currentLang as keyof typeof translations]['contact.copied']}</span>`;
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            renderCopyButton();
          }, 1800);
        } catch (err) {
          console.error('No se pudo copiar el correo', err);
        }
      });
    }

    // ---- MENÚ MÓVIL ----
    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelector('.nav-links');

    if (menuToggle && navLinks) {
      menuToggle.addEventListener('click', () => {
        navLinks.classList.toggle('active');
      });

      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('active');
        });
      });
    }
  </script>

</Layout>
