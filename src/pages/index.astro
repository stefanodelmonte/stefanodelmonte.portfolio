---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stefano Delmonte | Portfolio">

  <!-- EFECTO VISUAL DE FONDO (Cuadrícula arquitectónica + Spotlight interactivo + Orbes suaves) -->
  <div class="bg-visual" aria-hidden="true">
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
    <div class="bg-grid"></div>
    <div class="bg-spotlight" id="bgSpotlight"></div>
  </div>

  <!-- NAV -->
  <nav>
    <div class="container">
      <a href="#" class="nav-logo">SD</a>
      <button class="menu-toggle" aria-label="Menu">&#9776;</button>
      <ul class="nav-links">
        <li><a href="#about" data-i18n="nav.about">Sobre mí</a></li>
        <li><a href="#skills" data-i18n="nav.skills">Habilidades</a></li>
        <li><a href="#education" data-i18n="nav.education">Formación</a></li>
        <li><a href="#projects" data-i18n="nav.projects">Proyectos</a></li>
        <li><a href="#contact" data-i18n="nav.contact">Contacto</a></li>
        <li><button class="lang-btn" id="langToggle"><span class="flag" aria-hidden="true">🇪🇸</span> <span class="lang-label">ES</span></button></li>
      </ul>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" id="about">
    <div class="container">
      <div class="hero-content">
        <div class="hero-photo animate-in">
          <img src="/img/profile.webp" alt="Stefano Delmonte" />
        </div>
        <div class="hero-text">
          <div class="status-pill animate-in">
            <span class="status-dot"></span>
            <span data-i18n="hero.status">Disponible para prácticas FCT · Híbrido / Remoto</span>
          </div>
          <h1 class="animate-in delay-1">
            <span data-i18n="hero.greeting">Hola, soy</span><br />
            Stefano Delmonte
          </h1>
          <p class="role animate-in delay-2" data-i18n="hero.role">
            Estudiante de Desarrollo de Aplicaciones Multiplataforma
          </p>
          <p class="description animate-in delay-3" data-i18n="hero.description">
            Me gusta la tecnología y resolver problemas. Actualmente estoy formándome como desarrollador, aprendiendo cada día algo nuevo y buscando oportunidades para crecer profesionalmente en el mundo del software.
          </p>
          <div class="hero-actions animate-in delay-4">
            <a href="/cv/stefano-delmonte-cv-es.pdf" download id="cvDownload" class="btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span data-i18n="hero.downloadCV">Descargar CV</span>
            </a>
            <div class="social-links">
              <a href="https://www.linkedin.com/in/delmontestefano/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://github.com/stefanodelmonte" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </a>
              <a href="mailto:contactstefanodelmonte@gmail.com" class="social-link" aria-label="Email">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 / SKILLS -->
  <section id="skills">
    <div class="container">
      <div class="section-title">
        <span class="section-index">01 —</span>
        <span data-i18n="skills.title">Habilidades</span>
      </div>
      <div class="skills-columns">
        <div class="skill-group">
          <h3 class="skill-group-title" data-i18n="skills.backend">Backend</h3>
          <div class="skills-grid">
            <span class="skill-tag">Java</span>
            <span class="skill-tag">Spring Boot</span>
            <span class="skill-tag">Spring Data JPA</span>
            <span class="skill-tag">Thymeleaf</span>
            <span class="skill-tag">Maven</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title" data-i18n="skills.frontend">Frontend & Mobile</h3>
          <div class="skills-grid">
            <span class="skill-tag">TypeScript</span>
            <span class="skill-tag">Next.js</span>
            <span class="skill-tag">JavaScript</span>
            <span class="skill-tag">HTML & CSS</span>
            <span class="skill-tag">Kotlin</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-title" data-i18n="skills.tools">Datos & Entorno</h3>
          <div class="skills-grid">
            <span class="skill-tag">MySQL</span>
            <span class="skill-tag">PostgreSQL</span>
            <span class="skill-tag">SQL</span>
            <span class="skill-tag">Git & GitHub</span>
            <span class="skill-tag">Linux</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / EDUCATION & LANGUAGES -->
  <section id="education">
    <div class="container">
      <div class="section-title">
        <span class="section-index">02 —</span>
        <span data-i18n="education.title">Formación e Idiomas</span>
      </div>
      <div class="education-grid">
        <div class="timeline">
          <div class="timeline-item">
            <span class="timeline-date">2025 — 2027</span>
            <h3 class="timeline-role" data-i18n="education.dam.title">CFGS Desarrollo de Aplicaciones Multiplataforma (DAM)</h3>
            <p class="timeline-place">La Salle Tarragona · <span data-i18n="education.dam.year">2º curso</span></p>
            <p class="timeline-desc" data-i18n="education.dam.desc">Desarrollo backend con Java y Spring Boot, persistencia relacional (SQL/JPA), interfaces multiplataforma y desarrollo móvil con Kotlin.</p>
          </div>
        </div>
        <div class="languages-card">
          <h3 class="skill-group-title" data-i18n="education.languages">Idiomas</h3>
          <ul class="languages-list">
            <li>
              <span class="lang-name" data-i18n="lang.es">Español</span>
              <span class="lang-level" data-i18n="lang.native">Nativo</span>
            </li>
            <li>
              <span class="lang-name" data-i18n="lang.ca">Catalán</span>
              <span class="lang-level" data-i18n="lang.native2">Nativo</span>
            </li>
            <li>
              <span class="lang-name" data-i18n="lang.it">Italiano</span>
              <span class="lang-level" data-i18n="lang.native3">Nativo</span>
            </li>
            <li>
              <span class="lang-name" data-i18n="lang.en">Inglés</span>
              <span class="lang-level">B2</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / PROJECTS -->
  <section id="projects">
    <div class="container">
      <div class="section-title">
        <span class="section-index">03 —</span>
        <span data-i18n="projects.title">Proyectos</span>
      </div>
      <div class="projects-list">
        <article class="project-row">
          <a href="https://dualtrade-web.vercel.app/" target="_blank" rel="noopener noreferrer" class="project-row-image">
            <div class="window-bar" aria-hidden="true">
              <span class="window-dots"><i></i><i></i><i></i></span>
              <span class="window-url">dualtrade-web.vercel.app</span>
            </div>
            <img src="/img/dualtrade-preview.webp.png" alt="Dual Trade preview" />
          </a>
          <div class="project-row-content">
            <div class="project-header">
              <span class="project-index">01 / 02</span>
              <h3 class="project-title" data-i18n="projects.dualtrade.title">Dual Trade</h3>
            </div>
            <p class="project-description" data-i18n="projects.dualtrade.description">Landing page profesional para una comunidad de trading de criptomonedas basada en análisis técnico y fundamental. Incluye widgets de TradingView en tiempo real y animaciones fluidas.</p>
            <div class="project-tech">
              <span>Next.js</span>
              <span>TypeScript</span>
              <span>Framer Motion</span>
              <span>TradingView</span>
              <span>Vercel</span>
            </div>
            <div class="project-links">
              <a href="https://dualtrade-web.vercel.app/" target="_blank" rel="noopener noreferrer" class="ext-link">
                <span data-i18n="projects.viewLive">Ver en vivo</span>
                <span class="arrow-up-right" aria-hidden="true">↗</span>
              </a>
              <a href="https://github.com/stefanodelmonte/dualtrade" target="_blank" rel="noopener noreferrer" class="ext-link">
                <span data-i18n="projects.viewCode">Código</span>
                <span class="arrow-up-right" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
        <article class="project-row">
          <a href="https://github.com/stefanodelmonte/biblioteca" target="_blank" rel="noopener noreferrer" class="project-row-image">
            <div class="window-bar" aria-hidden="true">
              <span class="window-dots"><i></i><i></i><i></i></span>
              <span class="window-url">github.com/biblioteca</span>
            </div>
            <img src="/img/biblioteca-preview.png" alt="Biblioteca preview" />
          </a>
          <div class="project-row-content">
            <div class="project-header">
              <span class="project-index">02 / 02</span>
              <h3 class="project-title" data-i18n="projects.biblioteca.title">Biblioteca</h3>
            </div>
            <p class="project-description" data-i18n="projects.biblioteca.description">Aplicación web para la gestión de una biblioteca desarrollada con Java y Spring Boot. Permite gestionar libros, usuarios y préstamos con persistencia en MySQL y vistas con Thymeleaf.</p>
            <div class="project-tech">
              <span>Java</span>
              <span>Spring Boot</span>
              <span>MySQL</span>
              <span>Thymeleaf</span>
              <span>JPA</span>
              <span>Maven</span>
            </div>
            <div class="project-links">
              <a href="https://github.com/stefanodelmonte/biblioteca" target="_blank" rel="noopener noreferrer" class="ext-link">
                <span data-i18n="projects.viewCode">Código</span>
                <span class="arrow-up-right" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 04 / CONTACT -->
  <section id="contact">
    <div class="container">
      <div class="section-title">
        <span class="section-index">04 —</span>
        <span data-i18n="contact.title">Contacto</span>
      </div>
      <div class="contact-content">
        <p data-i18n="contact.description">Si quieres ponerte en contacto conmigo, puedes escribirme un correo o encontrarme en LinkedIn.</p>
        <div class="contact-actions">
          <a href="mailto:contactstefanodelmonte@gmail.com" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span data-i18n="contact.email">Enviar correo</span>
          </a>
          <button class="btn-secondary" id="copyEmailBtn" data-email="contactstefanodelmonte@gmail.com" aria-label="Copiar correo">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span class="copy-label">Copiar correo</span>
          </button>
          <a href="https://www.linkedin.com/in/delmontestefano/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container">
      <p>&copy; 2026 Stefano Delmonte. <span data-i18n="footer.rights">Todos los derechos reservados.</span></p>
    </div>
  </footer>

  <script>
    // ---- SPOTLIGHT INTERACTIVO DE FONDO ----
    const spotlight = document.getElementById('bgSpotlight');
    if (spotlight && window.matchMedia('(pointer: fine)').matches) {
      window.addEventListener('mousemove', (e) => {
        spotlight.style.setProperty('--mouse-x', `${e.clientX}px`);
        spotlight.style.setProperty('--mouse-y', `${e.clientY}px`);
      }, { passive: true });
    }

    // ---- SISTEMA DE INTERNACIONALIZACIÓN (i18n) ----
    const translations = {
      es: {
        'nav.about': 'Sobre mí',
        'nav.skills': 'Habilidades',
        'nav.education': 'Formación',
        'nav.projects': 'Proyectos',
        'nav.contact': 'Contacto',
        'hero.status': 'Disponible para prácticas FCT · Híbrido / Remoto',
        'hero.greeting': 'Hola, soy',
        'hero.role': 'Estudiante de Desarrollo de Aplicaciones Multiplataforma',
        'hero.description': 'Me gusta la tecnología y resolver problemas. Actualmente estoy formándome como desarrollador, aprendiendo cada día algo nuevo y buscando oportunidades para crecer profesionalmente en el mundo del software.',
