---
import EcosystemDiagram from './EcosystemDiagram.astro';
import Sansui from './Sansui.astro';
import { site, t as translate, type Lang, type Key } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (key: Key) => translate(lang, key);
const other: Lang = lang === 'es' ? 'en' : 'es';

// Medios del mockup Android. Ejemplos:
// { type: 'image', src: '/img/android/inicio.webp', width: 540, height: 1170 }
// { type: 'video', src: '/img/android/demo.webm', poster: '/img/android/poster.webp' }
type Media =
  | { type: 'none' }
  | { type: 'image'; src: string; width: number; height: number }
  | { type: 'video'; src: string; poster?: string };
const androidMedia = { type: 'none' } as Media;

// Cada proyecto toma sus textos de las claves "<id>.title", "<id>.status", "<id>.problem" y "<id>.solution".
// repo: sin definir oculta la fila de enlaces; vacío muestra "Código disponible bajo petición"
type ProjectId = 'tpv' | 'library' | 'android' | 'web';
const projects: { id: ProjectId; stack: string[]; repo?: string; android?: boolean }[] = [
  { id: 'tpv', stack: ['JavaScript', 'HTML', 'CSS', 'PWA', 'IndexedDB', 'WebUSB (ESC/POS)'] },
  {
    id: 'library',
    stack: ['Java 21', 'Spring Boot', 'JPA / Hibernate', 'MySQL', 'Thymeleaf', 'Maven'],
    repo: 'https://github.com/stefanodelmonte/biblioteca',
  },
  { id: 'android', stack: ['Kotlin', 'Android', 'API REST'], repo: '', android: true },
  {
    id: 'web',
    stack: ['Astro', 'TypeScript', 'CSS', 'WebGL', 'GitHub Actions'],
    repo: 'https://github.com/stefanodelmonte/stefanodelmonte.portfolio',
  },
];
const pk = (id: ProjectId, field: 'title' | 'status' | 'problem' | 'solution') => `${id}.${field}` as Key;

const skills = [
  { key: 'skills.backend', items: ['Java', 'Kotlin', 'Spring Boot', 'JPA / Hibernate', 'PostgreSQL', 'MySQL'] },
  { key: 'skills.frontend', items: ['JavaScript', 'TypeScript', 'HTML', 'CSS', 'Astro', 'Thymeleaf'] },
  { key: 'skills.tools', items: ['Git / GitHub', 'GitHub Actions', 'Maven', 'Google Workspace'] },
] as const;

const languages = [
  { key: 'lang.es', level: 'lang.native' },
  { key: 'lang.ca', level: 'lang.native' },
  { key: 'lang.en', level: 'B2' },
  { key: 'lang.it', level: 'B2' },
] as const;

const nav = [
  { id: 'projects', key: 'nav.projects' },
  { id: 'about', key: 'nav.about' },
  { id: 'contact', key: 'nav.contact' },
] as const;
---

<Sansui />
<div class="grain" aria-hidden="true"></div>

<a class="skip-link" href="#main" data-i18n="a11y.skip">{t('a11y.skip')}</a>

<header class="site-header">
  <div class="wrap header-inner">
    <a href={site.path[lang]} class="hanko" aria-label={t('a11y.home')} data-i18n-attr="aria-label:a11y.home">
      <span aria-hidden="true">SD</span>
    </a>

    <div class="header-tools">
      <nav id="siteNav" class="site-nav" aria-label={t('a11y.nav')} data-i18n-attr="aria-label:a11y.nav">
        <ul>
          {nav.map((item) => (
            <li><a href={`#${item.id}`} data-i18n={item.key}>{t(item.key)}</a></li>
          ))}
        </ul>
      </nav>

      <div class="switches">
        <button id="themeToggle" class="theme-toggle" type="button" aria-pressed="false"
                aria-label={t('a11y.theme')} data-i18n-attr="aria-label:a11y.theme">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="half" d="M12 3.6a8.4 8.4 0 0 1 0 16.8z" />
            <path class="enso" d="M13.6 3.75A8.4 8.4 0 1 1 9.4 4.1" />
          </svg>
        </button>

        <a id="langToggle" class="lang-toggle" href={site.path[other]} hreflang={other}
           aria-label={t('a11y.lang')} data-i18n-attr="aria-label:a11y.lang">
          <span class="lang-es" lang="es">ES</span><span class="lang-sep" aria-hidden="true">/</span><span class="lang-en" lang="en">EN</span>
        </a>
      </div>
    </div>
  </div>
</header>

<main id="main">
  <!-- Hero -->
  <section class="hero wrap" aria-labelledby="hero-name">
    <div class="hero-text">
      <h1 id="hero-name" data-reveal>Stefano <span class="nowrap">Delmonte<span class="seal-anchor" aria-hidden="true"><span class="seal"><span>S</span><span>D</span></span></span></span></h1>
      <p class="hero-title" data-reveal data-i18n="hero.title">{t('hero.title')}</p>
      <div class="hero-actions" data-reveal>
        <a id="cvDownload" class="btn" href={site.cv[lang]} download data-i18n="hero.cv">{t('hero.cv')}</a>
        <a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>

  <!-- Proyectos -->
  <section id="projects" class="section wrap" aria-labelledby="projects-title">
    <div class="section-body">
      <h2 id="projects-title" class="section-heading" data-reveal data-i18n="projects.heading">{t('projects.heading')}</h2>

      <!-- Lista de títulos; al pulsar uno, su detalle se abre en la ventana de abajo.
           Sin JS se ven todos los detalles seguidos -->
      <div class="works" data-reveal>
        {projects.map((p) => {
          const facts = (
            <dl class="project-facts">
              <div><dt data-i18n="projects.problem">{t('projects.problem')}</dt><dd data-i18n={pk(p.id, 'problem')}>{t(pk(p.id, 'problem'))}</dd></div>
              <div><dt data-i18n="projects.solution">{t('projects.solution')}</dt><dd data-i18n={pk(p.id, 'solution')}>{t(pk(p.id, 'solution'))}</dd></div>
              <div><dt data-i18n="projects.stack">{t('projects.stack')}</dt><dd class="stack">{p.stack.join(' · ')}</dd></div>
              {p.repo !== undefined && (
                <div><dt data-i18n="projects.links">{t('projects.links')}</dt><dd>
                  {p.repo
                    ? <a class="text-link" href={p.repo} target="_blank" rel="noopener noreferrer" data-i18n="projects.code">{t('projects.code')}</a>
                    : <span class="muted" data-i18n="projects.onRequest">{t('projects.onRequest')}</span>}
                </dd></div>
              )}
            </dl>
          );
          return (
            <div class="work">
              <button type="button" class="work-tab" aria-haspopup="dialog">
                <span class="work-title" data-i18n={pk(p.id, 'title')}>{t(pk(p.id, 'title'))}</span>
                <span class="work-status" data-i18n={pk(p.id, 'status')}>{t(pk(p.id, 'status'))}</span>
              </button>
              <div class="work-panel">
                {p.android ? (
                  <>
                    <EcosystemDiagram lang={lang} active="app" />
                    {facts}
                    <div class="phone">
                      <div class="phone-screen">
                        {androidMedia.type === 'image' && (
                          <img src={androidMedia.src} width={androidMedia.width} height={androidMedia.height} loading="lazy" decoding="async"
                               alt={t('android.mediaAlt')} data-i18n-attr="alt:android.mediaAlt" />
                        )}
                        {androidMedia.type === 'video' && (
                          <video src={androidMedia.src} poster={androidMedia.poster} autoplay muted loop playsinline preload="none"
                                 aria-label={t('android.mediaAlt')} data-i18n-attr="aria-label:android.mediaAlt"></video>
                        )}
                        {androidMedia.type === 'none' && (
                          <span class="phone-placeholder" data-i18n="android.placeholder">{t('android.placeholder')}</span>
                        )}
                      </div>
                    </div>
                  </>
                ) : facts}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Ventana del proyecto: el script mueve aquí el detalle al abrirla y lo devuelve al cerrarla -->
      <dialog id="workDialog" class="work-dialog" aria-labelledby="workDialogTitle">
        <div class="work-dialog-inner">
          <div class="work-dialog-head">
            <div>
              <h3 id="workDialogTitle" class="work-dialog-title" tabindex="-1" autofocus></h3>
              <p class="work-status"></p>
            </div>
            <button type="button" class="icon-btn work-dialog-close" aria-label={t('a11y.close')} data-i18n-attr="aria-label:a11y.close">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
          <div class="work-dialog-body"></div>
        </div>
      </dialog>
    </div>
  </section>

  <!-- Sobre mí: texto a la izquierda, ficha a la derecha -->
  <section id="about" class="section wrap" aria-labelledby="about-title">
    <div class="section-body">
      <h2 id="about-title" class="section-heading" data-reveal data-i18n="about.heading">{t('about.heading')}</h2>
      <div class="profile">
        <div class="about-text" data-reveal>
          <p class="lead" data-i18n="about.p1">{t('about.p1')}</p>
          <p data-i18n="about.p2">{t('about.p2')}</p>
        </div>
        <dl class="profile-facts" data-reveal>
          {skills.map((group) => (
            <div>
              <dt data-i18n={group.key}>{t(group.key)}</dt>
              <dd><ul>{group.items.map((item) => <li>{item}</li>)}</ul></dd>
            </div>
          ))}
          <div>
            <dt data-i18n="education.languages">{t('education.languages')}</dt>
            <dd>
              <ul class="lang-list">
                {languages.map((l) => (
                  <li>
                    <span data-i18n={l.key}>{t(l.key)}</span>
                    {l.level === 'B2'
                      ? <span class="muted">B2</span>
                      : <span class="muted" data-i18n={l.level}>{t(l.level)}</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
          <div class="fact-wide">
            <dt data-i18n="about.education">{t('about.education')}</dt>
            <dd>
              <span data-i18n="education.degree">{t('education.degree')}</span>
              <span class="muted">La Salle Tarragona · <span data-i18n="education.dates">{t('education.dates')}</span></span>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Contacto: cierre de la página -->
  <section id="contact" class="section wrap" aria-labelledby="contact-title">
    <div class="section-body">
      <h2 id="contact-title" class="section-heading" data-reveal data-i18n="contact.heading">{t('contact.heading')}</h2>
      <div class="contact-row" data-reveal>
        <span class="contact-key" data-i18n="contact.email">{t('contact.email')}</span>
        <a class="contact-value" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="contact-actions">
          <a class="icon-btn" href={`mailto:${site.email}`} title={t('contact.send')} data-i18n-attr="title:contact.send">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8.5 7H17v8.5" /></svg>
            <span class="sr-only" data-i18n="contact.send">{t('contact.send')}</span>
          </a>
          <button id="copyEmailBtn" class="icon-btn" type="button" aria-live="polite" title={t('contact.copy')} data-i18n-attr="title:contact.copy">
            <svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1" /><path d="M15 9V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h4" /></svg>
            <svg class="icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
            <span class="sr-only" data-i18n="contact.copy">{t('contact.copy')}</span>
          </button>
        </div>
      </div>
      <div class="contact-links" data-reveal>
        <a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer wrap">
  <p>&copy; 2026 Stefano Delmonte</p>
</footer>

<script>
  import { initI18n } from '../scripts/i18n';
  import { initTheme } from '../scripts/theme';
  initI18n();
  initTheme();

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Sin autoplay de vídeo si el usuario prefiere menos movimiento
  if (reduced) {
    document.querySelectorAll('video').forEach((v) => { v.autoplay = false; v.pause(); });
  }

  // Entrada suave de cada bloque al llegar a la vista
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reduced || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    items.forEach((el) => io.observe(el));
  }

  // Proyectos: el detalle se mueve a la ventana al abrirla y vuelve a su sitio al cerrarla
  const dialog = document.getElementById('workDialog') as HTMLDialogElement | null;
  const dialogBody = dialog?.querySelector<HTMLElement>('.work-dialog-body');
  const dialogTitle = dialog?.querySelector<HTMLElement>('.work-dialog-title');
  const dialogStatus = dialog?.querySelector<HTMLElement>('.work-status');

  // Cada detalle recuerda su proyecto para volver siempre a su sitio
  const homes = new Map<HTMLElement, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.work').forEach((work) => {
    const panel = work.querySelector<HTMLElement>('.work-panel');
    if (panel) homes.set(panel, work);
  });
  function restore() {
    dialogBody?.querySelectorAll<HTMLElement>('.work-panel').forEach((p) => homes.get(p)?.append(p));
  }

  // Copia texto y clave de traducción para que el cambio de idioma también los actualice
  function mirror(target: HTMLElement, source: HTMLElement | null) {
    target.textContent = source?.textContent ?? '';
    if (source?.dataset.i18n) target.dataset.i18n = source.dataset.i18n;
  }

  document.querySelectorAll<HTMLButtonElement>('.work-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const panel = tab.closest<HTMLElement>('.work')?.querySelector<HTMLElement>('.work-panel');
      if (!dialog || !dialogBody || !dialogTitle || !dialogStatus || !panel) return;
      // El evento de cierre llega después: si queda un detalle anterior, vuelve antes de abrir otro
      restore();
      mirror(dialogTitle, tab.querySelector('.work-title'));
      mirror(dialogStatus, tab.querySelector('.work-status'));
      dialogBody.append(panel);
      document.documentElement.classList.add('is-locked');
      if (!dialog.open) dialog.showModal();
      dialog.scrollTop = 0;
    });
  });

  dialog?.addEventListener('close', () => {
    if (dialog.open) return;
    restore();
    document.documentElement.classList.remove('is-locked');
  });
  dialog?.querySelector('.work-dialog-close')?.addEventListener('click', () => dialog.close());
  // Clic fuera de la ventana (sobre el fondo oscurecido)
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>
