<canvas id="sansui" class="sumi" aria-hidden="true"></canvas>

<script>
  // Sansui: montañas a pincel en una esquina que se pintan al cargar. Al bajar, la niebla las cubre
  const VERT = `
    attribute vec2 a_pos;
    void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
  `;

  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 u_res;
    uniform float u_aspect;
    uniform float u_time;
    uniform float u_scroll;
    uniform float u_fade;
    uniform float u_veil;
    uniform float u_paint;
    uniform float u_mx;
    uniform float u_scale;
    uniform vec3 u_ink;

    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
                 mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
    }
    // Perfil de cresta con picos: ruido «ridged» en varias octavas
    float peaks(float x, float seed) {
      float v = 0.0, a = 0.55, f = 1.0;
      for (int i = 0; i < 5; i++) {
        float n = 1.0 - abs(noise(vec2(x * f + seed, seed * 1.7)) * 2.0 - 1.0);
        v += a * n * n;
        f *= 2.1;
        a *= 0.5;
      }
      return v;
    }

    // Posición dentro de la esquina de las montañas (0 a 1); en ultrapanorámicos mide como mucho 1,6 veces el alto
    float cornerX(float x) {
      float reach = min(u_aspect, 1.6);
      return clamp((x - (u_aspect - reach)) / reach, 0.0, 1.0);
    }
    float cornerMask(float cx) {
      // En vertical la pendiente es más suave para no formar paredes
      return smoothstep(u_aspect < 0.8 ? -0.3 : 0.3, 0.95, cx);
    }

    // Altura de la cresta de una capa; se hunde hacia la izquierda conservando el perfil
    float ridgeAt(float x, float fi) {
      float depth = (fi + 1.0) / 3.0;
      float xs = x * (2.4 - fi * 0.5) + u_mx * 0.05 * depth + fi * 3.1;
      float top = (0.46 - fi * 0.12) + (peaks(xs, fi * 13.7) - 0.35) * (0.34 - fi * 0.08);
      top += (noise(vec2(x * 12.0, fi)) - 0.5) * 0.004; // detalle fino de la cresta
      float sink = u_aspect < 0.8 ? 0.28 : 0.55;
      return (top - (1.0 - cornerMask(cornerX(x))) * sink) * u_scale + u_scroll * (0.05 + 0.15 * depth);
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / u_res;
      float x = uv.x * u_aspect;
      float t = u_time;
      vec4 acc = vec4(0.0);

      // Composición a una esquina: las cordilleras nacen abajo a la derecha y dejan vacío el resto
      float cx = cornerX(x);
      float edgeFade = smoothstep(0.0, 0.4, cornerMask(cx));

      // De la capa más lejana a la más cercana
      for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float ridge = ridgeAt(x, fi);

        // Pintado al cargar: el pincel recorre cada cresta de izquierda a derecha y la aguada baja detrás
        float lp = clamp((u_paint - fi * 0.18) / 0.45, 0.0, 1.0);
        float head = mix(0.2, 1.08, lp);
        float drawn = 1.0 - smoothstep(head - 0.02, head, cx);
        float wp = clamp((u_paint - fi * 0.18 - 0.15) / 0.45, 0.0, 1.0);

        float below = ridge - uv.y;
        if (below > 0.0) {
          // Carga del pincel: cada trazo empieza cargado y se va secando
          float load = 1.0 - fract(cx * 1.7 + fi * 0.37) * 0.75;
          float w = (0.004 + 0.016 * noise(vec2(x * 2.5, fi * 5.0))) * (0.7 + fi * 0.35) * (0.55 + 0.6 * load);
          float stroke = 1.0 - smoothstep(w * 0.4, w, below);
          // Pincel seco: las vetas se abren donde queda menos tinta
          float streak = noise(vec2(x * 40.0 + fi * 11.0, below / w * 3.0));
          float dry = 1.0 - load;
          float kasure = smoothstep(0.1 + dry * 0.55, 0.3 + dry * 0.5, streak);
          float breaks = smoothstep(0.15, 0.35, noise(vec2(x * 2.2, fi * 7.3)));
          stroke *= kasure * breaks * (0.55 + 0.45 * load) * drawn;

          // Aguada clara que se funde en el papel
          float wash = exp(-below * (4.0 + fi * 3.0)) * (0.78 + 0.22 * noise(vec2(x * 25.0, uv.y * 25.0)));
          float lim = wp * 0.7;
          wash *= (1.0 - smoothstep(lim, lim + 0.08, below)) * smoothstep(0.0, 0.3, wp);
          wash *= 1.0 - smoothstep(head - 0.12, head - 0.02, cx);

          float a = max(stroke * (0.3 + fi * 0.25), wash * (0.14 + fi * 0.07)) * edgeFade;
          acc = vec4(u_ink * a, a) + acc * (1.0 - a);
        }
      }

      // Al bajar, la niebla sube desde abajo y se traga las montañas
      float wav = (noise(vec2(x * 1.2 + t * 0.03, 3.0)) - 0.5) * 0.12;
      float m = u_veil * 1.4 - 0.1;
      acc *= smoothstep(m - 0.25, m, uv.y + wav);

      gl_FragColor = acc * u_fade;
    }
  `;

  const FRAME_MS = 1000 / 30;
  const PAINT_MS = 2800;

  const canvas = document.getElementById('sansui') as HTMLCanvasElement | null;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const gl = canvas?.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: false, depth: false, stencil: false });

  if (canvas && gl) init(canvas, gl);
  else if (canvas) canvas.hidden = true;

  function init(canvas: HTMLCanvasElement, gl: WebGLRenderingContext) {
    function compile(type: number, src: string) {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
      return s;
    }

    const prog = gl.createProgram()!;
    try {
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    } catch {
      canvas.hidden = true;
      return;
    }
    gl.bindAttribLocation(prog, 0, 'a_pos');
    gl.linkProgram(prog);
    gl.useProgram(prog);
    const u = (name: string) => gl.getUniformLocation(prog, name);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    // Tinta sumi neutra, apenas fría
    gl.uniform3f(u('u_ink'), 0.1, 0.105, 0.115);

    let w = 0, h = 0, raf = 0, last = 0, t = 0;
    const paintStart = performance.now();
    const seal = document.querySelector<HTMLElement>('.seal');
    // Progreso del pintado inicial; con movimiento reducido aparece ya terminado
    const paintOf = () => (reduced.matches ? 1 : Math.min((performance.now() - paintStart) / PAINT_MS, 1));
    const mouse = { x: 0, target: 0 };

    function resize() {
      w = window.innerWidth;
      h = window.innerHeight;
      // Resolución adaptativa: nitidez según la densidad de píxeles, con un tope de ~2,5 Mpx
      const scale = Math.min(Math.min(window.devicePixelRatio || 1, 1.5), Math.sqrt(2.5e6 / (w * h)));
      canvas.width = Math.max(2, Math.round(w * scale));
      canvas.height = Math.max(2, Math.round(h * scale));
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(u('u_res'), canvas.width, canvas.height);
      gl.uniform1f(u('u_aspect'), w / h);
      // En pantallas verticales el texto baja más: montañas algo más bajas
      gl.uniform1f(u('u_scale'), w / h < 0.8 ? 0.72 : 1);
    }

    // Progreso del scroll en alturas de pantalla
    const progress = () => window.scrollY / h;
    // La niebla cubre las montañas entre 0 y 0,6 pantallas de scroll
    const veilOf = (s: number) => Math.min(Math.max(s / 0.6, 0), 1);
    const fadeOf = (s: number) => 1 - Math.min(Math.max((s - 0.5) / 0.2, 0), 1);

    function draw() {
      const s = progress();
      gl.uniform1f(u('u_time'), t);
      gl.uniform1f(u('u_scroll'), reduced.matches ? 0 : s);
      gl.uniform1f(u('u_fade'), fadeOf(s));
      gl.uniform1f(u('u_veil'), veilOf(s));
      const paint = paintOf();
      gl.uniform1f(u('u_paint'), paint);
      // El sello se estampa al terminar de pintar
      if (paint >= 1) seal?.classList.add('is-stamped');
      document.documentElement.style.setProperty('--mountains', String(1 - veilOf(s)));
      gl.uniform1f(u('u_mx'), mouse.x);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      const dt = now - last;
      if (dt < FRAME_MS) return;
      last = now;
      t += Math.min(dt, 100) / 1000;
      mouse.x += (mouse.target - mouse.x) * 0.06;
      draw();
      // Fuera del hero no hay nada que pintar
      if (fadeOf(progress()) === 0 && paintOf() >= 1) stop();
    }

    function start() {
      if (raf || document.hidden || reduced.matches) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    window.addEventListener('scroll', () => {
      if (reduced.matches) draw();
      else if (fadeOf(progress()) > 0) start();
      else draw();
    }, { passive: true });

    if (matchMedia('(pointer: fine)').matches) {
      window.addEventListener('pointermove', (e) => { mouse.target = e.clientX / w - 0.5; }, { passive: true });
    }

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { resize(); draw(); }, 150);
    }, { passive: true });

    // Con movimiento reducido: imagen fija que solo se desvanece al bajar
    reduced.addEventListener('change', () => { if (reduced.matches) stop(); else start(); draw(); });

    canvas.addEventListener('webglcontextlost', () => { stop(); canvas.hidden = true; });

    resize();
    draw();
    start();
  }
</script>
