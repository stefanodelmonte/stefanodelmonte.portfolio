<canvas id="sumi" class="sumi" aria-hidden="true"></canvas>

<script>
  // Tinta sumi: el puntero deposita tinta que se difunde por las fibras del papel y se seca en ~4 s
  const VERT = `
    attribute vec2 a_pos;
    varying vec2 v_uv;
    void main() { v_uv = a_pos * 0.5 + 0.5; gl_Position = vec4(a_pos, 0.0, 1.0); }
  `;

  const NOISE = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    varying vec2 v_uv;
    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
                 mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
    }
  `;

  // Paso de simulación: desplazamiento por scroll, difusión, trazo y secado
  const SIM = NOISE + `
    uniform sampler2D u_prev;
    uniform vec2 u_texel;
    uniform vec2 u_shift;
    uniform vec2 u_a;
    uniform vec2 u_b;
    uniform float u_radius;
    uniform float u_amount;
    uniform float u_aspect;
    uniform float u_decay;
    uniform float u_seed;
    void main() {
      vec2 uv = v_uv + u_shift;
      float c = texture2D(u_prev, uv).r;
      float fib = noise(v_uv * vec2(140.0 * u_aspect, 55.0));
      vec2 o = u_texel * (1.0 + fib);
      float n = texture2D(u_prev, uv + vec2(o.x, 0.0)).r + texture2D(u_prev, uv - vec2(o.x, 0.0)).r
              + texture2D(u_prev, uv + vec2(0.0, o.y)).r + texture2D(u_prev, uv - vec2(0.0, o.y)).r;
      float d = c + 0.18 * fib * (n - 4.0 * c);

      vec2 s = vec2(u_aspect, 1.0);
      vec2 p = v_uv * s, a = u_a * s, ab = u_b * s - a;
      float h = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-6), 0.0, 1.0);
      float dist = length(p - a - ab * h);
      float edge = u_radius * (0.7 + 0.6 * noise(p * 70.0 + u_seed));
      d += smoothstep(edge, edge * 0.2, dist) * u_amount * (1.0 - d);

      gl_FragColor = vec4(max(d - u_decay, 0.0), 0.0, 0.0, 1.0);
    }
  `;

  // Pintado: densidad a color, cálido cuando está diluida, con textura de fibra
  const DRAW = NOISE + `
    uniform sampler2D u_ink;
    uniform vec3 u_dark;
    uniform vec3 u_warm;
    uniform float u_alpha;
    void main() {
      float d = texture2D(u_ink, v_uv).r;
      float fib = noise(gl_FragCoord.xy * vec2(0.8, 0.3));
      float a = smoothstep(0.0, 0.85, d) * (0.8 + 0.2 * fib) * u_alpha;
      vec3 col = mix(u_warm, u_dark, smoothstep(0.15, 0.75, d));
      gl_FragColor = vec4(col * a, a);
    }
  `;

  const STEP = 1000 / 60;
  const DECAY = 1.01 / 255; // un nivel de 8 bits por paso: se borra del todo
  const IDLE_MS = 5000;

  const hex = (v: string, fallback: number[]) => {
    const m = v.trim().match(/^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i);
    return m ? m.slice(1).map((x) => parseInt(x, 16) / 255) : fallback;
  };

  const canvas = document.getElementById('sumi') as HTMLCanvasElement | null;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const gl = canvas && !reduced.matches
    ? canvas.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: false, depth: false, stencil: false })
    : null;

  if (canvas && gl) init(canvas, gl);
  else if (canvas) canvas.hidden = true;

  function init(canvas: HTMLCanvasElement, gl: WebGLRenderingContext) {
    const css = getComputedStyle(document.documentElement);
    const dark = hex(css.getPropertyValue('--ink'), [0.12, 0.12, 0.12]);
    const warm = hex(css.getPropertyValue('--gray'), [0.43, 0.38, 0.35]);

    function compile(type: number, src: string) {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
      return s;
    }
    function program(frag: string) {
      const p = gl.createProgram()!;
      gl.attachShader(p, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(p, compile(gl.FRAGMENT_SHADER, frag));
      gl.bindAttribLocation(p, 0, 'a_pos');
      gl.linkProgram(p);
      const u: Record<string, WebGLUniformLocation | null> = {};
      const n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
      for (let i = 0; i < n; i++) {
        const name = gl.getActiveUniform(p, i)!.name;
        u[name] = gl.getUniformLocation(p, name);
      }
      return { p, u };
    }

    let sim: ReturnType<typeof program>, draw: ReturnType<typeof program>;
    try {
      sim = program(SIM);
      draw = program(DRAW);
    } catch {
      canvas.hidden = true;
      return;
    }

    const quad = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, quad);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    // Dos texturas para alternar lectura y escritura
    let w = 0, h = 0, simW = 0, simH = 0;
    let targets: { tex: WebGLTexture; fb: WebGLFramebuffer }[] = [];
    let read = 0;

    function makeTarget() {
      const tex = gl.createTexture()!;
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, simW, simH, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
      const fb = gl.createFramebuffer()!;
      gl.bindFramebuffer(gl.FRAMEBUFFER, fb);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
      gl.clearColor(0, 0, 0, 1);
      gl.clear(gl.COLOR_BUFFER_BIT);
      return { tex, fb };
    }

    // Resolución de simulación a la mitad: más barata y con bordes suaves al escalar
    function resize() {
      w = window.innerWidth;
      h = window.innerHeight;
      simW = Math.max(2, Math.round(w / 2));
      simH = Math.max(2, Math.round(h / 2));
      canvas.width = simW;
      canvas.height = simH;
      targets.forEach((t) => { gl.deleteTexture(t.tex); gl.deleteFramebuffer(t.fb); });
      targets = [makeTarget(), makeTarget()];
      read = 0;
    }

    // Trazo pendiente en coordenadas de pantalla
    const pen = { x: 0, y: 0, px: 0, py: 0, has: false, amount: 0, radius: 0 };
    let drops: { x: number; y: number }[] = [];
    let scrollShift = 0, lastScroll = window.scrollY;
    let lastInput = 0, raf = 0, last = 0, acc = 0;

    function step(a: number[], b: number[], amount: number, radius: number, shiftY: number) {
      const src = targets[read], dst = targets[1 - read];
      gl.bindFramebuffer(gl.FRAMEBUFFER, dst.fb);
      gl.viewport(0, 0, simW, simH);
      gl.useProgram(sim.p);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, src.tex);
      gl.uniform1i(sim.u.u_prev, 0);
      gl.uniform2f(sim.u.u_texel, 1 / simW, 1 / simH);
      gl.uniform2f(sim.u.u_shift, 0, shiftY);
      gl.uniform2f(sim.u.u_a, a[0], a[1]);
      gl.uniform2f(sim.u.u_b, b[0], b[1]);
      gl.uniform1f(sim.u.u_radius, radius / h);
      gl.uniform1f(sim.u.u_amount, amount);
      gl.uniform1f(sim.u.u_aspect, w / h);
      gl.uniform1f(sim.u.u_decay, DECAY);
      gl.uniform1f(sim.u.u_seed, Math.random() * 100);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      read = 1 - read;
    }

    function render() {
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, simW, simH);
      gl.useProgram(draw.p);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, targets[read].tex);
      gl.uniform1i(draw.u.u_ink, 0);
      gl.uniform3fv(draw.u.u_dark, dark);
      gl.uniform3fv(draw.u.u_warm, warm);
      gl.uniform1f(draw.u.u_alpha, 0.3);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    }

    const uv = (x: number, y: number) => [x / w, 1 - y / h];

    function frame(now: number) {
      acc += Math.min(now - last, 100);
      last = now;
      let first = true;
      while (acc >= STEP) {
        acc -= STEP;
        // La tinta se mueve con el papel al hacer scroll
        const shift = first ? -scrollShift / h : 0;
        if (first) scrollShift = 0;
        first = false;
        if (pen.has) {
          step(uv(pen.px, pen.py), uv(pen.x, pen.y), pen.amount, pen.radius, shift);
          pen.px = pen.x; pen.py = pen.y; pen.has = false;
        } else if (drops.length) {
          const d = drops.shift()!;
          step(uv(d.x, d.y), uv(d.x, d.y), 0.9, 30, shift);
        } else {
          step([-1, -1], [-1, -1], 0, 0, shift);
        }
      }
      render();
      // Sin entrada reciente la tinta ya se ha secado: se detiene el bucle
      raf = now - lastInput < IDLE_MS ? requestAnimationFrame(frame) : 0;
    }

    function wake() {
      lastInput = performance.now();
      if (raf || document.hidden) return;
      last = performance.now();
      acc = 0;
      raf = requestAnimationFrame(frame);
    }

    let moved = false;
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const dx = e.clientX - pen.x, dy = e.clientY - pen.y;
      if (!moved) { pen.px = e.clientX; pen.py = e.clientY; moved = true; }
      // Lento deja más tinta y más ancha; rápido, pincel seco
      const speed = Math.min(Math.hypot(dx, dy) / 30, 1);
      pen.amount = 0.6 - speed * 0.4;
      pen.radius = 20 - speed * 9;
      pen.x = e.clientX; pen.y = e.clientY; pen.has = true;
      wake();
    }, { passive: true });

    // Toque o clic: una gota que florece
    window.addEventListener('pointerdown', (e) => {
      drops.push({ x: e.clientX, y: e.clientY });
      if (drops.length > 4) drops.shift();
      wake();
    }, { passive: true });

    window.addEventListener('scroll', () => {
      scrollShift += window.scrollY - lastScroll;
      lastScroll = window.scrollY;
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(raf); raf = 0; }
      else if (performance.now() - lastInput < IDLE_MS) wake();
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { resize(); render(); }, 150);
    }, { passive: true });

    reduced.addEventListener('change', () => {
      if (!reduced.matches) return;
      cancelAnimationFrame(raf);
      raf = 0;
      canvas.hidden = true;
    });

    canvas.addEventListener('webglcontextlost', () => { cancelAnimationFrame(raf); raf = 0; canvas.hidden = true; });

    resize();
    render();
  }
</script>
