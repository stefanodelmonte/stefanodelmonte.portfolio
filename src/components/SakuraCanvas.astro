<canvas id="sakura" class="sakura" aria-hidden="true"></canvas>

<script>
  type State = 'fall' | 'land' | 'rest' | 'fade';

  interface Layer { size: [number, number]; speed: [number, number]; alpha: number; blur: number; breeze: number }
  interface Petal {
    layer: number; x: number; y: number; size: number; vy: number; vx: number;
    swayAmp: number; swayFreq: number; phase: number;
    rot: number; rotSpeed: number; flip: number; flipSpeed: number;
    alpha: number; state: State; timer: number; ground: number;
  }

  // Media y cercana; la lejana queda fuera con un único pétalo
  const LAYERS: Layer[] = [
    { size: [14, 18], speed: [30, 40], alpha: 0.45, blur: 0.4, breeze: 0.5 },
    { size: [18, 24], speed: [36, 48], alpha: 0.7, blur: 0, breeze: 1 },
  ];
  const COLOR = getComputedStyle(document.documentElement).getPropertyValue('--sakura').trim() || '#D8B4B0';
  const FADE = 1.5;
  const INTERVAL: [number, number] = [8, 15]; // segundos entre pétalos
  const FIRST_DELAY: [number, number] = [2, 4];

  // Pétalo unitario: base abajo, punta arriba con muesca
  const PETAL = new Path2D(
    'M0 0.5 C0.42 0.3 0.46 -0.22 0.13 -0.5 L0 -0.36 L-0.13 -0.5 C-0.46 -0.22 -0.42 0.3 0 0.5 Z'
  );

  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  const canvas = document.getElementById('sakura') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (canvas && ctx) {
    let w = 0, h = 0, dpr = 1;
    let petal: Petal | null = null;
    let raf = 0, last = 0, t = 0;
    let spawnTimer = 0, nextAt = 0, remaining = rand(...FIRST_DELAY) * 1000;
    const mouse = { x: -1e4, y: -1e4, vx: 0, at: 0 };

    function spawn(): Petal {
      const layer = Math.random() < 0.5 ? 0 : 1;
      const L = LAYERS[layer];
      const size = rand(L.size[0], L.size[1]);
      return {
        layer, size,
        // Entra por la mitad izquierda y deriva hacia la derecha
        x: rand(0.05, 0.6) * w,
        y: -size * 2,
        vy: rand(L.speed[0], L.speed[1]),
        vx: 0,
        swayAmp: rand(22, 40),
        swayFreq: rand(0.35, 0.7),
        phase: rand(0, Math.PI * 2),
        rot: rand(0, Math.PI * 2),
        rotSpeed: rand(-0.8, 0.8),
        flip: rand(0, Math.PI * 2),
        flipSpeed: rand(1.2, 2.2),
        alpha: 1, state: 'fall', timer: 0,
        ground: h - size * rand(0.25, 0.45),
      };
    }

    // Programa el siguiente pétalo sin mantener el bucle activo
    function schedule(ms: number) {
      clearTimeout(spawnTimer);
      remaining = ms;
      nextAt = performance.now() + ms;
      spawnTimer = window.setTimeout(() => {
        remaining = 0;
        petal = spawn();
        start();
      }, ms);
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      if (petal) {
        petal.ground = h - petal.size * 0.35;
        if (petal.state !== 'fall') petal.y = petal.ground;
      }
      if (!raf) draw();
    }

    function update(p: Petal, dt: number) {
      const L = LAYERS[p.layer];
      if (p.state === 'fall') {
        // Brisa suave al mover el ratón cerca
        if (performance.now() - mouse.at < 120) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy, R = 180;
          if (d2 < R * R) {
            const f = (1 - Math.sqrt(d2) / R) * L.breeze;
            p.vx += mouse.vx * f * 9 * dt;
            p.rotSpeed += mouse.vx * f * 0.0008;
          }
        }
        p.vx *= Math.exp(-1.4 * dt);
        const sway = Math.cos(t * p.swayFreq + p.phase) * p.swayAmp * p.swayFreq;
        p.x += (sway + p.vx + 10) * dt;
        p.y += p.vy * dt;
        p.rot += p.rotSpeed * dt;
        p.flip += p.flipSpeed * dt;
        if (p.y >= p.ground) {
          // Conserva la inercia lateral al posarse
          p.y = p.ground;
          p.vx = sway + p.vx;
          p.state = 'land';
        }
      } else if (p.state === 'land') {
        const k = Math.exp(-3.2 * dt);
        p.vx *= k;
        p.rotSpeed *= k;
        p.flipSpeed *= k;
        p.x += p.vx * dt;
        p.rot += p.rotSpeed * dt;
        p.flip += p.flipSpeed * dt;
        if (Math.abs(p.vx) < 1.5) { p.state = 'rest'; p.timer = rand(3, 6); }
      } else if (p.state === 'rest') {
        p.timer -= dt;
        if (p.timer <= 0) { p.state = 'fade'; p.timer = FADE; }
      } else {
        p.timer -= dt;
        p.alpha = Math.max(0, p.timer / FADE);
        if (p.timer <= 0) {
          petal = null;
          schedule(rand(...INTERVAL) * 1000);
        }
      }
      // Si sale por un lateral, termina y se programa el siguiente
      if (petal && (p.x < -60 || p.x > w + 60)) {
        petal = null;
        schedule(rand(...INTERVAL) * 1000);
      }
    }

    function draw() {
      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      if (!petal) return;
      const p = petal;
      const L = LAYERS[p.layer];
      ctx!.fillStyle = COLOR;
      ctx!.filter = L.blur ? `blur(${L.blur * dpr}px)` : 'none';
      // Volteo 3D: scaleX oscila entre -1 y 1
      const sx = Math.cos(p.flip);
      ctx!.globalAlpha = L.alpha * p.alpha * (0.75 + 0.25 * Math.abs(sx));
      ctx!.setTransform(dpr, 0, 0, dpr, p.x * dpr, p.y * dpr);
      ctx!.rotate(p.rot);
      ctx!.scale(p.size * (Math.abs(sx) < 0.08 ? 0.08 * Math.sign(sx || 1) : sx), p.size);
      ctx!.fill(PETAL);
      ctx!.filter = 'none';
      ctx!.globalAlpha = 1;
    }

    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      t += dt;
      if (petal) update(petal, dt);
      draw();
      // Sin pétalo no hay nada que animar
      raf = petal ? requestAnimationFrame(frame) : 0;
    }

    function start() {
      if (raf || !petal || reduced.matches || document.hidden) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function pause() {
      cancelAnimationFrame(raf);
      raf = 0;
      // Guarda el tiempo pendiente hasta el siguiente pétalo
      if (!petal) {
        remaining = Math.max(0, nextAt - performance.now());
        clearTimeout(spawnTimer);
      }
    }

    function resume() {
      if (reduced.matches) return;
      if (petal) start();
      else schedule(remaining);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    }, { passive: true });

    // Cambio de densidad de píxeles (mover ventana entre pantallas, zoom)
    const watchDpr = () => {
      matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`).addEventListener('change', () => { resize(); watchDpr(); }, { once: true });
    };
    watchDpr();

    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : resume()));

    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        pause();
        petal = null;
        draw();
        canvas.hidden = true;
      } else {
        canvas.hidden = false;
        resume();
      }
    });

    if (matchMedia('(pointer: fine)').matches) {
      window.addEventListener('pointermove', (e) => {
        const now = performance.now();
        const dt = Math.max(now - mouse.at, 16);
        mouse.vx = now - mouse.at > 200 ? 0 : ((e.clientX - mouse.x) / dt) * 16;
        mouse.x = e.clientX; mouse.y = e.clientY; mouse.at = now;
      }, { passive: true });
    }

    resize();
    if (reduced.matches) canvas.hidden = true;
    else schedule(remaining);
  }
</script>
