---
// Mascot.astro - Mascota animada cartoon años 30 (monitor CRT con disquete)
---

<div id="mascot-stage" class="mascot-stage" aria-hidden="true">
  <div id="mascot-sprite" class="mascot-sprite">
    <img
      src="/mascot/mascot.png"
      alt="Mascota CRT"
      width="90"
      height="90"
      draggable="false"
    />
  </div>
</div>

<button
  id="mascot-toggle"
  class="mascot-toggle"
  type="button"
  aria-label="Silenciar o activar mascota animada"
  title="Mascota CRT (clic para silenciar/activar)"
>
  <span class="mascot-toggle-icon">📺</span>
  <span id="mascot-toggle-text" class="mascot-toggle-text">ON</span>
</button>

<style>
  .mascot-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 80;
  }

  .mascot-sprite {
    position: absolute;
    top: 0;
    left: 0;
    width: 90px;
    height: 90px;
    opacity: 0;
    transform: translate3d(-200px, -200px, 0) scale(0);
    transform-origin: center bottom;
    will-change: transform, opacity;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: pointer;
  }

  .mascot-sprite img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.45));
  }

  .mascot-toggle {
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 105;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: rgba(18, 18, 18, 0.85);
    border: 1px solid var(--color-border, #222);
    color: var(--color-text-secondary, #888);
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    border-radius: 4px;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.2s ease;
    user-select: none;
  }

  .mascot-toggle:hover {
    border-color: var(--color-accent, #3b82f6);
    color: var(--color-text, #fff);
  }

  .mascot-toggle.is-muted {
    opacity: 0.5;
    border-style: dashed;
  }

  .mascot-toggle.is-muted .mascot-toggle-text {
    color: #666;
  }

  /* Desactivar completamente en móvil (< 768px) o prefers-reduced-motion */
  @media (max-width: 767px) {
    .mascot-stage,
    .mascot-toggle {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot-stage,
    .mascot-toggle {
      display: none !important;
    }
  }
</style>

<script>
  // Inicialización de la mascota
  (function initMascot() {
    // Respetar preferencias de accesibilidad y tamaño de pantalla
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(max-width: 767px)').matches) return;

    const stage = document.getElementById('mascot-stage') as HTMLElement | null;
    const sprite = document.getElementById('mascot-sprite') as HTMLElement | null;
    const toggleBtn = document.getElementById('mascot-toggle') as HTMLButtonElement | null;
    const toggleText = document.getElementById('mascot-toggle-text') as HTMLElement | null;

    if (!stage || !sprite || !toggleBtn || !toggleText) return;

    const STORAGE_KEY = 'stefano_mascot_disabled';
    const SPRITE_SIZE = 90;

    let isMuted = localStorage.getItem(STORAGE_KEY) === 'true';
    let isRunning = false;
    let isInteracting = false;
    let currentX = -200;
    let currentY = -200;
    let loopTimeout: number | null = null;
    let activeElements: HTMLElement[] = [];

    // Helper sleep con cancelación rápida
    const sleep = (ms: number): Promise<void> =>
      new Promise((resolve) => {
        const id = window.setTimeout(resolve, ms);
        if (!isRunning) clearTimeout(id);
      });

    // Helper para aplicar transform sin tocar left/top (60fps)
    function applyTransform(
      x: number,
      y: number,
      scale = 1,
      rot = 0,
      opacity = 1,
      transition = 'transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease'
    ) {
      currentX = x;
      currentY = y;
      sprite.style.transition = transition;
      sprite.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${scale}) rotate(${rot}deg)`;
      sprite.style.opacity = `${opacity}`;
    }

    // Entrada pop-in (scale + pequeño rebote)
    async function popIn(x: number, y: number, rot = 0) {
      sprite.style.pointerEvents = 'auto';
      // Posición inicial oculta
      applyTransform(x, y, 0, rot, 0, 'none');
      await sleep(20);
      // Salto con rebote
      applyTransform(x, y, 1.12, rot, 1, 'transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease');
      await sleep(320);
      applyTransform(x, y, 1, rot, 1, 'transform 0.18s ease-out, opacity 0.2s ease');
      await sleep(180);
    }

    // Salida pop-out
    async function popOut() {
      sprite.style.pointerEvents = 'none';
      applyTransform(currentX, currentY, 1.15, 0, 1, 'transform 0.15s ease-in');
      await sleep(150);
      applyTransform(currentX, currentY, 0, 0, 0, 'transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease');
      await sleep(240);
    }

    // Susto / escape rápido al clicar
    async function escapeJump() {
      if (isInteracting) return;
      isInteracting = true;
      sprite.style.pointerEvents = 'none';
      applyTransform(
        currentX,
        currentY - 45,
        1.25,
        18,
        1,
        'transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.3)'
      );
      await sleep(180);
      applyTransform(
        currentX,
        currentY + 60,
        0,
        -15,
        0,
        'transform 0.25s ease-in, opacity 0.2s ease'
      );
      await sleep(260);
      cleanActiveElements();
      isInteracting = false;
    }

    // Restaurar estilos de elementos que la mascota haya movido
    function cleanActiveElements() {
      activeElements.forEach((el) => {
        if (el) {
          el.style.transition = '';
          el.style.transform = '';
        }
      });
      activeElements = [];
      stage.style.zIndex = '80';
    }

    // --- TRASTADAS (Array de funciones async fáciles de ampliar) ---
    const mischiefs = [
      // 1. Asomarse por una esquina y saludar
      async function peekCornerAndWave() {
        const fromLeft = Math.random() > 0.5;
        const x = fromLeft ? -15 : window.innerWidth - SPRITE_SIZE + 15;
        const y = window.innerHeight - SPRITE_SIZE - 20;
        const baseRot = fromLeft ? 18 : -18;

        await popIn(x, y, baseRot);
        // Saludo suave (rotación estilo cartoon)
        for (let i = 0; i < 3; i++) {
          if (!isRunning || isInteracting) return;
          applyTransform(x, y, 1, baseRot + (fromLeft ? -12 : 12), 1, 'transform 0.28s ease-in-out');
          await sleep(280);
          applyTransform(x, y, 1, baseRot, 1, 'transform 0.28s ease-in-out');
          await sleep(280);
        }
        await sleep(400);
        await popOut();
      },

      // 2. Escondida detrás del título con el nombre (Hero)
      async function peekBehindTitle() {
        const titleEl = document.querySelector('.hero-text h1') as HTMLElement | null;
        if (!titleEl) {
          await mischiefs[0]();
          return;
        }

        const rect = titleEl.getBoundingClientRect();
        // Si el título no está visible en viewport, usar otra
        if (rect.bottom < 60 || rect.top > window.innerHeight - 100) {
          await mischiefs[0]();
          return;
        }

        // Colocar la capa justo detrás del título
        stage.style.zIndex = '1';
        titleEl.style.position = 'relative';
        titleEl.style.zIndex = '2';
        activeElements.push(titleEl);

        const x = rect.right - SPRITE_SIZE + 20;
        const y = rect.top - 35;

        await popIn(x, y + 25, -12);
        // Asoma la cabeza hacia arriba
        applyTransform(x, y, 1.05, 8, 1, 'transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)');
        await sleep(1500);

        // Mira a ambos lados
        applyTransform(x + 8, y, 1, -8, 1, 'transform 0.3s ease');
        await sleep(800);
        applyTransform(x, y + 30, 0.8, 0, 0.4, 'transform 0.3s ease-in');
        await sleep(350);

        await popOut();
        stage.style.zIndex = '80';
      },

      // 3. Subirse / apoyarse en una tarjeta de proyecto
      async function perchOnProjectCard() {
        const cards = Array.from(document.querySelectorAll('.project-row')) as HTMLElement[];
        const visibleCards = cards.filter((c) => {
          const r = c.getBoundingClientRect();
          return r.top >= 60 && r.bottom <= window.innerHeight + 100;
        });

        if (visibleCards.length === 0) {
          await mischiefs[0]();
          return;
        }

        const targetCard = visibleCards[Math.floor(Math.random() * visibleCards.length)];
        const rect = targetCard.getBoundingClientRect();
        const x = rect.left + Math.min(rect.width - SPRITE_SIZE - 20, 80);
        const y = rect.top - SPRITE_SIZE + 18; // apoyada en el borde superior

        await popIn(x, y, 0);

        // Pequeño balanceo de piernas
        for (let i = 0; i < 2; i++) {
          if (!isRunning || isInteracting) return;
          applyTransform(x, y - 4, 1.04, 6, 1, 'transform 0.25s ease-out');
          await sleep(250);
          applyTransform(x, y, 1, -6, 1, 'transform 0.25s ease-out');
          await sleep(250);
        }
        await sleep(1200);
        await popOut();
      },

      // 4. Inclinar o hacer temblar un elemento (tarjeta o habilidad)
      async function tiltOrShake() {
        const candidates = Array.from(
          document.querySelectorAll('.project-row, .skill-tag, .section-title')
        ) as HTMLElement[];

        const visible = candidates.filter((el) => {
          const r = el.getBoundingClientRect();
          return r.top >= 80 && r.bottom <= window.innerHeight - 50;
        });

        if (visible.length === 0) {
          await mischiefs[0]();
          return;
        }

        const target = visible[Math.floor(Math.random() * visible.length)];
        const rect = target.getBoundingClientRect();
        activeElements.push(target);

        const x = rect.right - 25;
        const y = rect.top - 40;

        await popIn(x, y, 15);
        await sleep(200);

        // Tiembla el elemento
        target.style.transition = 'transform 0.12s ease';
        for (let i = 0; i < 4; i++) {
          if (!isRunning || isInteracting) return;
          target.style.transform = i % 2 === 0 ? 'rotate(2deg) translateY(-2px)' : 'rotate(-2deg) translateY(2px)';
          applyTransform(x, y + (i % 2 === 0 ? -3 : 3), 1, 15 + (i % 2 === 0 ? 5 : -5), 1, 'transform 0.12s ease');
          await sleep(140);
        }

        // Restaura el elemento
        target.style.transform = '';
        await sleep(800);
        await popOut();
        cleanActiveElements();
      },

      // 5. Empujar un elemento de lado y devolverlo
      async function pushElement() {
        const candidates = Array.from(
          document.querySelectorAll('.skill-tag, .project-tech span, .btn-primary, .project-title')
        ) as HTMLElement[];

        const visible = candidates.filter((el) => {
          const r = el.getBoundingClientRect();
          return r.top >= 80 && r.bottom <= window.innerHeight - 50 && r.left > 40 && r.right < window.innerWidth - 80;
        });

        if (visible.length === 0) {
          await mischiefs[0]();
          return;
        }

        const target = visible[Math.floor(Math.random() * visible.length)];
        const rect = target.getBoundingClientRect();
        activeElements.push(target);

        const x = rect.left - SPRITE_SIZE + 15;
        const y = rect.top - 15;

        await popIn(x, y, 5);
        await sleep(300);

        // Empujón hacia la derecha
        target.style.transition = 'transform 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.2)';
        target.style.transform = 'translateX(22px)';
        applyTransform(x + 18, y, 1.08, 12, 1, 'transform 0.18s ease-out');
        await sleep(900);

        // Lo devuelve a su sitio
        target.style.transform = '';
        applyTransform(x, y, 1, 0, 1, 'transform 0.25s ease');
        await sleep(500);

        await popOut();
        cleanActiveElements();
      },

      // 6. Pasear por el borde inferior de la pantalla
      async function walkBottom() {
        const y = window.innerHeight - SPRITE_SIZE - 8;
        const startX = -SPRITE_SIZE;
        const stopX = Math.floor(window.innerWidth * 0.25 + Math.random() * (window.innerWidth * 0.4));

        applyTransform(startX, y, 1, 0, 1, 'none');
        await sleep(50);

        // Camina con balanceo
        const steps = 6;
        for (let i = 0; i <= steps; i++) {
          if (!isRunning || isInteracting) return;
          const currentWalkX = startX + (stopX - startX) * (i / steps);
          const rot = i % 2 === 0 ? 8 : -8;
          applyTransform(currentWalkX, y, 1, rot, 1, 'transform 0.26s ease-in-out');
          await sleep(260);
        }

        // Se para a mirar con cara alegre
        applyTransform(stopX, y, 1.1, 0, 1, 'transform 0.2s ease-out');
        await sleep(1400);

        // Despide y baja
        await popOut();
      }
    ];

    // Selección inteligente según la sección visible
    function selectMischief() {
      const scrollY = window.scrollY;
      const projectsEl = document.getElementById('projects');
      if (projectsEl) {
        const pRect = projectsEl.getBoundingClientRect();
        if (pRect.top < window.innerHeight && pRect.bottom > 100) {
          // Cerca de proyectos: priorizar subirse o inclinar
          return Math.random() > 0.4 ? mischiefs[2] : mischiefs[3];
        }
      }
      if (scrollY < 400) {
        // En el hero: priorizar asomarse tras el título o esquina
        return Math.random() > 0.5 ? mischiefs[1] : mischiefs[0];
      }
      // Cualquier otra trastada aleatoria
      return mischiefs[Math.floor(Math.random() * mischiefs.length)];
    }

    // Intervalo aleatorio entre 8 y 20 segundos
    function getNextDelay() {
      return Math.floor(Math.random() * (20000 - 8000 + 1)) + 8000;
    }

    // Bucle principal de ejecución
    async function runLoop() {
      if (!isRunning || isMuted || document.hidden) return;

      const action = selectMischief();
      try {
        await action();
      } catch (err) {
        console.debug('Mascot mischief reset', err);
      } finally {
        cleanActiveElements();
      }

      if (isRunning && !isMuted && !document.hidden) {
        loopTimeout = window.setTimeout(runLoop, getNextDelay());
      }
    }

    // Iniciar y pausar el ciclo
    function start() {
      if (isRunning || isMuted) return;
      isRunning = true;
      loopTimeout = window.setTimeout(runLoop, 3500); // primera aparición a los 3.5s
    }

    function stop() {
      isRunning = false;
      if (loopTimeout) clearTimeout(loopTimeout);
      loopTimeout = null;
      cleanActiveElements();
      applyTransform(currentX, currentY, 0, 0, 0, 'none');
      sprite.style.pointerEvents = 'none';
    }

    // Interacción: clic para saltar y escapar
    sprite.addEventListener('click', (e) => {
      e.stopPropagation();
      escapeJump();
    });

    // Interacción: si el cursor se acerca demasiado (esquivar)
    window.addEventListener('mousemove', (e) => {
      if (!isRunning || isInteracting || sprite.style.opacity !== '1') return;
      const mascotCenterX = currentX + SPRITE_SIZE / 2;
      const mascotCenterY = currentY + SPRITE_SIZE / 2;
      const dist = Math.hypot(e.clientX - mascotCenterX, e.clientY - mascotCenterY);

      if (dist < 65) {
        escapeJump();
      }
    });

    // Pausar si la pestaña se oculta
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stop();
      } else if (!isMuted) {
        start();
      }
    });

    // Control del botón de silenciado
    function updateToggleUI() {
      if (isMuted) {
        toggleBtn.classList.add('is-muted');
        toggleText.textContent = 'OFF';
        toggleBtn.title = 'Mascota silenciada (clic para activar)';
      } else {
        toggleBtn.classList.remove('is-muted');
        toggleText.textContent = 'ON';
        toggleBtn.title = 'Mascota activa (clic para silenciar)';
      }
    }

    toggleBtn.addEventListener('click', () => {
      isMuted = !isMuted;
      localStorage.setItem(STORAGE_KEY, String(isMuted));
      updateToggleUI();
      if (isMuted) {
        stop();
      } else {
        start();
      }
    });

    // Iniciar según preferencia
    updateToggleUI();
    if (!isMuted) {
      start();
    }

    // Limpieza al desmontar
    window.addEventListener('beforeunload', () => {
      stop();
    });
  })();
</script>
